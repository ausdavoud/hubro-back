Enum user_roles {
  Player
  Instructor
  null
}

Table custome_users {
  id integer [pk]
  username varchar
  password varchar
  email varchar

  role user_roles

  created_at date
  updated_at date
}

Table instructors {
  id integer [pk]
  user_id integer [ref: - custome_users.id] 

  created_at date
  updated_at date
}

Table simulation_classes {
  id integer [pk]
  name varchar(50)
  instructor_id integer [ref: > instructors.id]

  created_at date
  updated_at date
}

Table teams {
  id integer [pk]
  name varchar(20)
  simulation_class_id integer [ref: > simulation_classes.id]

  created_at date
  updated_at date
}

Table players {
  id integer [pk]
  user_id integer [ref: - custome_users.id]
  team_id integer [ref: > teams.id]

  created_at date
  updated_at date
}

Enum contract_statuses {
  fulfilled
  waiting
  expired 
}


Table contracts {
  id integer [pk]
//   player_id integer [ref: > players.id]
  closure_quarter integer
  payment_quarter integer
  quantity integer
  unit_price decimal(15)
  total_price decimal(15)
  deliverable_product_id integer [ref: > rnd_prodcuts.id]
  status contract_status
}


Enum factory_statuses {
  owned
  rented
}

Table factories {
  id integer [pk]
//   player_id integer [ref: > players.id]
  ownershop factory_status
  quarterly_output integer
  outsourcing_fee_per_unit decimal(15)
  labor_cost_per_unit decimal(15)
  maintenance_cost decimal(15)
  fixed_cost decimal(15)
  resale_value_percent decimal(15, 2)
  build_cost decimal(15)
  workers integer
  hours decimal(5, 2)
  wage decimal(5, 2)
  emission_t_unit decimal(5, 2)
  depreciation_time integer
  build_time integer
  base integer

  created_at date
  updated_at date
}

Table productions {
  id integer [pk]
//   player_id integer [ref: > players.id]
  product_id integer [ref: - rnd_prodcuts.id]
  factory_id integer [ref: - factories.id]
  quarter integer
  activity_level decimal(5, 2)
  activity_factor decimal(5, 2)
  produced_quantity integer
  labor_cost decimal(15)

  created_at date
  updated_at date
}


Enum rnd_types {
  product
  upgrade
}

Table rnd_statics {
  id integer [pk]
  type rnd_types
  title varchar
  price decimal
  depreciation_time integer
  original_unit_mat_cost decimal // same as production
  development_duration integer

  created_at date
  updated_at date
}


Table rnd_prodcuts {
  id integer [pk]
//   player_id integer [ref: > players.id]
  static_id integer [ref: > rnd_statics.id]
  started_at integer
  time_spent_developing integer
  alias varchar(50)
  icon_link varchar(300)

  created_at date
  updated_at date
}

Table rnd_upgrades {
  id integer [pk]
//   player_id integer [ref: > players.id]
  static_id integer
  started_at integer
  time_spent_developing integer
  updated_product_id integer [ref: > rnd_prodcuts.id]

  created_at date
  updated_at date
}

Enum transaction_types {
  paid
  recieved
}

Table storage {
  id integer [pk]
//   player_id integer [ref: > players.id]
  product_id integer [ref: > rnd_prodcuts.id]
  count integer
  transaction_type transaction_types
  quarter integer
  finished_goods_inventory integer

  created_at date
  updated_at date
}


Table cash_changes {
  id integer [pk]
//   player_id integer [ref: > players.id]
  beginning_cash decimal(15)
  ending_cash decimal(15)
  quarter integer

  created_at date
  updated_at date
}


Table overdrafts {
  id integer [pk]
//   player_id integer [ref: > players.id]
  beginning_over_draft decimal(15)
  ending_over_draft decimal(15)
  quarter integer

  created_at date
  updated_at date
}


Table loans {
  id int [pk]
//   player_id integer [ref: > players.id]
  amount decimal(15)
  issued_quarter integer
  interest decimal(5, 2)
  payback_peroid integer
  total_payback decimal(15)
  payback_per_quarter decimal(15)

  created_at date
  updated_at date
}

Table repayments {
  id integer
//   player_id integer [ref: > players.id]
  loan_id integer [ref: > loans.id]
  interest_amount decimal(15)
  repayment_amount decimal(15) 
  left decimal(15)
  quarter integer

  created_at date
  updated_at date

  indexes {
    (id, loan_id) [pk]
  }
}


Table state_variables {
  esg_index integer
  fixed_interest integer
  current_quarter integer
  simulation_duration integer
  max_loan_repayment integer

  created_at date
  updated_at date
}

Table ripple_tasks {
  id integer [pk]
  quarter integer
  type varchar

  created_at date
  updated_at date
}


Table recurring_actions {
  id integer [pk]
  quarter integer 
  type integer

  created_at date
  updated_at date
}


Table transactions {
  id integer [pk]
  document_id integer
  quarter integer
  debit_amount decimal
  credit_amount decimal
  financial_account_id integer [ref: > financial_accounts.id]
}

Enum financial_account_types {
  depreciation_of_factories
  factories
  amortization
  researched_technology
  direct_labor
  direct_raw_materials
  finished_goods_inventory
  storage
  cash
  current_portion_of_loans_payable
  interest_expenses
  maintenance
  promotion
  sales
  overdraft
  long_term_notes_payable
  raw_material_inventory
}

Table financial_accounts {
  id integer [pk]
  name financial_account_types
  type varchar
}
