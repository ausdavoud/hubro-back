#!/bin/bash

SOCK_DIR=$(pwd)
DEV_MODE=0

while [[ $# -gt 0 ]]; do
    case $1 in
        --sock-dir)
            SOCK_DIR="$2"
            shift 2
            ;;
        --dev)
            DEV_MODE=1
            shift
            ;;
        *)
            echo "Unknown argument: $1"
            exit 1
            ;;
    esac
done

source ./venv/bin/activate

if [ $DEV_MODE -eq 1 ]; then
    python3 manage.py runserver 0.0.0.0:8000
else
    gunicorn config.wsgi:application --bind unix:${SOCK_DIR}/hub.sock
fi
